# Automatic HTTPS when DOMAIN is a real domain (set ACME_EMAIL in .env).
# IP-only access stays on plain HTTP for health checks.

{
	email {$ACME_EMAIL}
}

{$DOMAIN:localhost} {
	encode gzip
	request_body {
		max_size 25MB
	}

	@uploads path /uploads/*
	handle @uploads {
		reverse_proxy app:3000
		header Cache-Control "public, max-age=31536000, immutable"
	}

	@static path /_next/static/*
	handle @static {
		reverse_proxy app:3000
		header Cache-Control "public, max-age=31536000, immutable"
	}

	reverse_proxy app:3000
}

# Optional: redirect www → apex (add DNS CNAME www → @ first)
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN}{uri} permanent
}

# Catch-all HTTP by IP / localhost (pre-DNS or health checks)
:80 {
	encode gzip
	reverse_proxy app:3000
}
